    "background": {
      "interactive": {
        "default": {
          "$type": "color",
          "$value": "{color.yellow.500}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{color.yellow.100}"
        },
        "hover": {
          "$type": "color",
          "$value": "{color.yellow.700}"
        }
      }
    },
    "border": {
      "interactive": {
        "outline": {
          "default": {
